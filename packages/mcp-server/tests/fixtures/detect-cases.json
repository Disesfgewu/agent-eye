[
  {
    "name": "vite + react with npm",
    "files": { "package.json": "{\"scripts\":{\"dev\":\"vite\"},\"dependencies\":{\"react\":\"18\"},\"devDependencies\":{\"vite\":\"5\"}}" },
    "expect": [{ "dir": ".", "stack": "Vite · React", "command": "npm", "args": ["run", "dev"], "port": 5173 }]
  },
  {
    "name": "pnpm lockfile switches the package manager",
    "files": { "web/package.json": "{\"scripts\":{\"dev\":\"vite\"},\"devDependencies\":{\"vite\":\"5\"}}", "web/pnpm-lock.yaml": "" },
    "expect": [{ "dir": "web", "stack": "Vite", "command": "pnpm", "args": ["dev"], "port": 5173 }]
  },
  {
    "name": "next.js with an explicit port in the script",
    "files": { "package.json": "{\"scripts\":{\"dev\":\"next dev -p 4000\"},\"dependencies\":{\"next\":\"14\",\"react\":\"18\"}}" },
    "expect": [{ "dir": ".", "stack": "Next.js", "command": "npm", "args": ["run", "dev"], "port": 4000, "portSource": "config" }]
  },
  {
    "name": "package.json without a dev/start script is not a runnable project",
